{
  "rules": {
    "rooms": {
      "$room": {
        ".validate": "$room.matches(/^[a-z0-9]{3,12}$/)",
        "pos": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.val() === null || (newData.child('x').isNumber() && newData.child('y').isNumber())"
          }
        },
        "info": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.val() === null || newData.child('n').isString()"
          }
        }
      }
    },
    "tower": {
      ".read": "auth != null",
      ".indexOn": ["best"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.child('best').isNumber() && newData.child('best').val() >= 0 && newData.child('best').val() <= 100000"
      }
    }
  }
}
